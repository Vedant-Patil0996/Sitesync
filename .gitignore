# =====================================================================
# SiteSync — Root .gitignore
# Stack: Next.js (TypeScript) frontend | Node.js backend | Python AI
# =====================================================================

# ── Node.js ──────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnp
.pnp.js
.pnpm-store/

# ── Next.js ──────────────────────────────────────────────────────────
.next/
out/

# ── Build / dist outputs ─────────────────────────────────────────────
build/
dist/

# ── TypeScript ───────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Environment variables (NEVER commit secrets) ──────────────────────
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
.venv

# ── SSL / Certs ───────────────────────────────────────────────────────
*.pem
*.key
*.crt

# ── Testing / Coverage ────────────────────────────────────────────────
coverage/
.jest-cache/
.jest/

# ── Deployment ────────────────────────────────────────────────────────
.vercel
.netlify/

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Python: Virtual Environments ──────────────────────────────────────
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Python: Type checking & testing ───────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pytest_cache/
.ruff_cache/

# ── Jupyter ───────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── IDE / Editor ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS specific ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
